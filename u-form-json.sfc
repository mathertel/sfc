<!--

Implementation of a web component that enriches the functionality of regular <form> element to support data exchange
with JSON data.

Copyright (c) 2025 by Matthias Hertel, http://www.mathertel.de
This work is licensed under a BSD-3-Clause license. See http://www.mathertel.de/License.aspx

By extending a form element with u-form-json, the form data can be retrieved as JSON object including empty values and
boolean values.

``` html
<form is="u-form-json" method="dialog" dh-path="path" dh-mode="submit">
...
</form>
```

-->

<script extends="form">

  /**
   * @typedef {Object.<string, any>} FormDataRecord
   * @description Represents a record containing form data with string keys and any type of values
   */

  /// @brief UFormJson extends the HTMLFormElement to support JSON data exchange
  export default class UFormJson extends HTMLFormElement {

    // private
    #analyzed = false;
    /** @type {FormDataRecord} */
    #emptyRecord = {};
    #booleanAttributes = new Set();

    #dataHubSyncPath = '';
    #dataHubMode = 'sync';
    #dataHubSyncGuard = false; // prevent recursive updates between form and datahub
    #dataHubSubscriptionId = null; // subscription id for datahub updates
    #listenersReady = false; // prevent multiple event listener registrations

    static get observedAttributes() {
      return ['dh-path', 'dh-mode'];
    }

    attributeChangedCallback(name, _oldValue, newValue) {
      if (name === 'dh-path') {
        this.#dataHubSyncPath = (newValue ?? '').trim();
        this.#setupDataHubSync();
      } else if (name === 'dh-mode') {
        this.#dataHubMode = (newValue ?? '').trim().toLowerCase() === 'submit' ? 'submit' : 'sync';
      }
    }

    #setupDataHubSync() {
      const dh = window.datahub;

      if (this.#dataHubSubscriptionId !== null && dh && typeof dh.unsubscribe === 'function') {
        dh.unsubscribe(this.#dataHubSubscriptionId);
        this.#dataHubSubscriptionId = null;
      }

      if (!this.#dataHubSyncPath) return;

      if (!dh || typeof dh.subscribe !== 'function' || typeof dh.publish !== 'function') {
        return;
      }

      this.#dataHubSubscriptionId = dh.subscribe(this.#dataHubSyncPath, (_path, value) => {
        if (this.#dataHubSyncGuard) return;

        if (value === undefined) {
          this.#dataHubSyncGuard = true;
          try {
            this.setJsonData(Object.assign({}, this.#emptyRecord));
          } finally {
            this.#dataHubSyncGuard = false;
          }
          return;
        }

        this.#dataHubSyncGuard = true;
        try {
          this.setJsonData(value);
        } finally {
          this.#dataHubSyncGuard = false;
        }
      });

      const current = dh.get(this.#dataHubSyncPath);
      if (current !== undefined) {
        this.#dataHubSyncGuard = true;
        try {
          this.setJsonData(current);
        } finally {
          this.#dataHubSyncGuard = false;
        }
      }
    }

    /// @brief Synchronize the form data to the DataHub if a sync path is defined.
    /// @param {boolean} [force=false] - If true, forces synchronization even in 'submit' mode.
    #syncToDataHub(force = false) {
      const dh = window.datahub;
      if (!this.#dataHubSyncPath || !dh || typeof dh.publish !== 'function') return;
      if (this.#dataHubMode === 'submit' && !force) return;
      if (this.#dataHubSyncGuard) return;

      this.#dataHubSyncGuard = true;
      try {
        dh.publish(this.#dataHubSyncPath, this.getJsonData());
      } finally {
        this.#dataHubSyncGuard = false;
      }
    }

    _validateForm() {
      const v = this.checkValidity();
      this.querySelectorAll("button[type=Submit]").forEach(btn => {
        btn.disabled = !v;
      });
    }

    connectedCallback() {
      console.debug('u-form-json', 'connected()');

      if (!this.#listenersReady) {
        this.addEventListener("change", this._validateForm);
        this.addEventListener("keyup", this._validateForm);

        this.addEventListener("change", () => this.#syncToDataHub());
        this.addEventListener("input", () => this.#syncToDataHub());
        this.addEventListener("submit", () => this.#syncToDataHub(true));
        this.#listenersReady = true;
      }

      this.#setupDataHubSync();
    }

    disconnectedCallback() {
      const dh = window.datahub;
      if (this.#dataHubSubscriptionId !== null && dh && typeof dh.unsubscribe === 'function') {
        dh.unsubscribe(this.#dataHubSubscriptionId);
      }
      this.#dataHubSubscriptionId = null;
    }

    // analyse all form element types that can be used as input to create an empty record
    // including all known form elements.
    _analyze() {
      this.querySelectorAll('input[name]').forEach(e => this.#emptyRecord[e.name] = '');
      this.querySelectorAll('textarea[name]').forEach(e => this.#emptyRecord[e.name] = '');
      this.querySelectorAll('select[name]').forEach(e => this.#emptyRecord[e.name] = e.value || '');
      this.querySelectorAll('input[name][type=range]').forEach(e => this.#emptyRecord[e.name] = 0);
      this.querySelectorAll('input[name][type=color]').forEach(e => this.#emptyRecord[e.name] = '#000000');
      this.querySelectorAll('input[name][type=checkbox]').forEach(e => {
        this.#emptyRecord[e.name] = false;
        this.#booleanAttributes.add(e.name);
      });
      this.#analyzed = true;
      // not: output, meter
    }


    /// @brief return the formData as Object including empty values.
    /// @return {FormDataRecord}
    getJsonData() {
      if (!this.#analyzed) this._analyze();
      const formData = new FormData(this);
      /** @type {FormDataRecord} */
      let jData = Object.fromEntries(formData);
      jData = Object.assign({}, this.#emptyRecord, jData);
      Object.entries(jData).forEach(([name, value]) => {
        if (this.#booleanAttributes.has(name)) {
          jData[name] = Boolean(value === 'on');
        }
      });
      return (jData);
    } // getJsonData()


    /// @brief Set the value of the form elements according the name including form output elements
    /// @param {FormDataRecord} jData
    setJsonData(jData) {
      let hasChanged = false;
      if (!this.#analyzed) this._analyze();
      Object.entries(jData).forEach(([name, value] = entry) => {
        this.querySelectorAll(`*[name=${name}]`).forEach(el => {
          if (el.type === 'radio') {
            if (el.checked !== (el.value === value)) {
              el.checked = (el.value === value);
              hasChanged = true;
            }
          } else if (el.type === 'checkbox') {
            if (el.checked !== (!!value)) {
              el.checked = (!!value);
              hasChanged = true;
            }
          } else if ((el.tagName === 'METER') || (el.tagName === 'OUTPUT')) {
            // output elements
            el.value = value;
          } else {
            if (el.value !== value) {
              el.value = value;
              hasChanged = true;
            }
          }
        });
      });

      if (hasChanged) {
        // create 'change' event on form element when form data was really changed.
        const evt = new Event('change');
        this.dispatchEvent(evt);
      }
    } // setJsonData()

  } // class
</script>