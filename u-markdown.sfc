<template>
  <slot></slot>
</template>

<script>
export default class MyMarkdown extends UComponent {
  static get observedAttributes() {
    return ["textcontent", "value", "src"];
  }
  srcLink = undefined;

  // text from markdown file or direct text
  srcText = undefined;
  // text from markdown file or direct text
  srcText = null;

  // Markdown renderer
  md = null;

  constructor() {
    super();
    this.importScript("markdown-it.js");
    this.importScript("markdown-it-attrs.js");
  }

  // fetch file content
  fetchMarkdown() {
    this.textContent = '(process url...)';

    fetch(this.srcLink)
      .then(response => response.text())
      .then(text => {
        this.srcText = text;
        this.renderMarkdown();
      });
  }

  // render markdown
  renderMarkdown() {
    if (!this.md) {
      window.markdownItAttrs

      this.md = window.markdownit({
        html: true,
        linkify: true,
        typographer: true
      })
        .use(window.markdownItAttrs);
    }
    this.innerHTML = this.md.render(this.srcText);
  }

  // process markdown
  process() {
    if (window.markdownit) {
      if (this.srcText) {
        this.renderMarkdown();
      } else if (this.srcLink) {
        this.fetchMarkdown();
      }
    }
  }

  // This init() will be called once by the loader and then when all scripts are loaded.
  // Then processing is required.
  init() {
    if (this._scriptsUnloaded == 0) this.process();
  } // init()


  attributeChangedCallback(name, oldValue, newValue) {
    if (newValue) {
      this.srcLink = this.srcText = undefined;
      if (name === 'src') {
        this.srcLink = newValue;

      } else if ((name === 'textcontent') || (name === 'value')) {
        this.srcText = newValue;
      }
      if (this._scriptsUnloaded == 0) this.process();
    }
  } // attributeChangedCallback()

}
</script>