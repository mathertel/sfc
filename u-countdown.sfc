<script>
  export default class UCountdown extends UComponent {
    static observedAttributes = ["dh-path", "autostart"];

    #timer;
    #dhPath = "";
    #autostart = false;
    #initialized = false;

    attributeChangedCallback(name, oldValue, newValue) {
      if (name === "dh-path") {
        this.#dhPath = newValue || "";
      } else if (name === "autostart") {
        this.#autostart = newValue !== null;
        if (this.#autostart && this.#initialized) {
          this.start();
        }
      }
    }

    init() {
      this.#initialized = true;
      if (this.#autostart) {
        this.start();
      }
    }

    disconnectedCallback() {
      this.stop();
    }

    start(initialValue) {
      const path = this.#dhPath;
      if (!path || !window.datahub) {
        return;
      }

      if (initialValue !== undefined) {
        const initialSeconds = this.#durationSeconds(initialValue);
        if (initialSeconds === undefined) {
          return;
        }

        this.stop();
        window.datahub.publish(path, this.#formatDuration(initialSeconds));
      } else if (this.#timer !== undefined) {
        return;
      }

      if (this.#durationSeconds(window.datahub.get(path)) === undefined) {
        return;
      }

      this.#timer = window.setInterval(() => this.#tick(), 1000);
    }

    startFor(timestamp) {
      const timestampMs = new Date(timestamp).getTime();
      if (!Number.isFinite(timestampMs)) {
        return;
      }

      const initialSeconds = Math.max(0, Math.ceil((timestampMs - Date.now()) / 1000));
      this.start(this.#formatDuration(initialSeconds));
    }

    stop() {
      if (this.#timer !== undefined) {
        window.clearInterval(this.#timer);
        this.#timer = undefined;
      }
    }

    #tick() {
      const path = this.#dhPath;
      const totalSeconds = this.#durationSeconds(window.datahub?.get(path));

      if (totalSeconds === undefined) {
        this.stop();
        return;
      }

      const remaining = Math.max(0, totalSeconds - 1);

      window.datahub.publish(path, this.#formatDuration(remaining));

      if (remaining === 0) {
        this.stop();
        this.dispatchEvent(new Event("done", { bubbles: true }));
      }
    }

    #durationSeconds(value) {
      if (typeof value === "number") {
        return Number.isSafeInteger(value) && value >= 0 ? value : undefined;
      }

      if (typeof value !== "string") return undefined;

      let match = value.match(/^(\d+):([0-5]\d):([0-5]\d)$/);
      if (match) {
        return Number(match[1]) * 3600 + Number(match[2]) * 60 + Number(match[3]);
      }

      match = value.match(/^(\d+):([0-5]\d)$/);
      if (!match) return undefined;

      return Number(match[1]) * 60 + Number(match[2]);
    }

    #formatDuration(totalSeconds) {
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor(totalSeconds % 3600 / 60);
      const seconds = totalSeconds % 60;
      return `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    }
  }
</script>