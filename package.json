{
  "name": "sfc",
  "version": "1.0.0",
  "description": "Using Single File Components (SFC) client side by loading components from the browser.",
  "license": "BSD 3-Clause",
  "author": "Matthias Hertel",
  "type": "module",
  "bin": {
    "pack-sfc": "bin/pack-sfc.js"
  },
  "scripts": {
    "serve": "npx http-server -p 4173 -d -i -c-1 ",
    "test:e2e": "playwright test",
    "test:e2e:show": "playwright test --headed --workers=1",
    "test:src": "tsc -noEmit -p src\\tsconfig.json",
    "build:loader": "esbuild src\\loader.ts                         --minify    --drop:console --drop:debugger --outfile=loader.js",
    "build:loader-watch": "esbuild src\\loader.ts                         --sourcemap --watch                        --outfile=loader.js",
    "build:watch": "esbuild src\\*.ts   --format=esm --sourcemap --watch --outdir=./",
    "build:bundle": "pack-sfc *.sfc -o bundle.sfc",
    "clean": "del *.js.map loader.js json-parse.js",
    "build": "npm run test:src && npm run build:loader",
    "pack": "bin\\pack.bat",
    "publish:site": "copy /Y build\\*.* C:\\Users\\Matthias\\Projects\\mathertel-WebSite\\mathertel9\\wwwroot\\sfc",
    "linkcheck": "markdown-link-check ./doc",
    "dev": "run-p test:src build:loader-watch serve"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "^7.0.2",
    "yargs": "^18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
